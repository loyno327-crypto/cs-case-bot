# Токен бота из @BotFather
BOT_TOKEN=CHANGE_ME

# Публичный HTTPS-адрес WebApp (Telegram открывает Mini App только по HTTPS).
# Локально удобно получить через туннель, например: https://xxxx.ngrok-free.app
WEBAPP_URL=https://your-tunnel-url.example

# Подключение к базе (по умолчанию — локальный SQLite-файл)
DATABASE_URL=sqlite+aiosqlite:///./game.db

# Хост/порт FastAPI-сервера
HOST=0.0.0.0
PORT=8000

# Режим отладки.
# True  — можно тестировать WebApp в обычном браузере (без валидной подписи Telegram).
# False — на проде: запросы к API принимаются только с валидным Telegram initData.
DEBUG=True
